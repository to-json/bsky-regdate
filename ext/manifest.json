{
  "manifest_version": 3,
  "name": "regdate in bio",
  "version": "0.1.0",
  "description": "Shows when a Bluesky account was registered, under its bio. Written in Alexandrite.",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bsky.app/*",
        "https://witchsky.app/*",
        "https://blacksky.community/*",
        "https://mu.social/*",
        "https://deer.social/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://public.api.bsky.app/*",
    "https://plc.directory/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": { "id": "regdate-in-bio@alexandrite", "strict_min_version": "121.0" }
  }
}
