TAB = 9
NEWLINE = 10
CARRIAGE_RETURN = 13
SPACE = 32
QUOTE = 34
HYPHEN = 45
DOT = 46
COLON = 58
OPEN_BRACKET = 91
BACKSLASH = 92
CLOSE_BRACKET = 93
OPEN_BRACE = 123
CLOSE_BRACE = 125
ZERO = 48
NINE = 57
TWO = 50
SEVEN = 55
LOWER_A = 97
LOWER_Z = 122
UPPER_A = 65
UPPER_Z = 90

fn lowercase?(b: Byte) -> Bool { b >= LOWER_A && b <= LOWER_Z }
fn uppercase?(b: Byte) -> Bool { b >= UPPER_A && b <= UPPER_Z }
fn letter?(b: Byte) -> Bool { lowercase?(b) || uppercase?(b) }
fn digit?(b: Byte) -> Bool { b >= ZERO && b <= NINE }
fn whitespace?(b: Byte) -> Bool { b == SPACE || b == TAB || b == NEWLINE || b == CARRIAGE_RETURN }
fn opens_container?(b: Byte) -> Bool { b == OPEN_BRACE || b == OPEN_BRACKET }
fn closes_container?(b: Byte) -> Bool { b == CLOSE_BRACE || b == CLOSE_BRACKET }
fn hostname_byte?(b: Byte) -> Bool { letter?(b) || digit?(b) || b == HYPHEN || b == DOT }
fn base32_byte?(b: Byte) -> Bool { lowercase?(b) || (b >= TWO && b <= SEVEN) }
